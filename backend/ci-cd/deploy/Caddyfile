{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 21MB
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@internal path /actuator /actuator/*
	handle @internal {
		respond 404
	}
	@api path /v1 /v1/* /s /s/* /swagger-ui /swagger-ui/* /swagger-ui.html /v3 /v3/*
	handle @api {
		reverse_proxy app:8080
	}
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:app:8080}
	}
}
