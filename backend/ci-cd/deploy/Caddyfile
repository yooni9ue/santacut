# SITE_ADDRESS는 compose가 넘긴다. DOMAIN이 있으면 그 도메인(HTTPS), 없으면 :80(평문 HTTP)이다.
# ACME_EMAIL은 도메인이 있을 때만 쓴다. 비어 있으면 빈 문자열로 들어가 이메일 없이 인증서를 받는다.
{
    email "{$ACME_EMAIL}"
    admin off
}

{$SITE_ADDRESS::80} {
    # 진행 상황 스트림(SSE)은 압축하지 않는다. 압축기가 이벤트를 모아 두면 브라우저에 늦게 닿는다.
    @events path /v1/analyses/*/events
    @compressible not path /v1/analyses/*/events
    encode @compressible zstd gzip
    # 원본 파일 업로드만 21MB(파일 20MB + multipart 여분)까지 받고, 나머지 요청 본문은 2MB로 막는다.
    @upload path /v1/analyses/files
    @notUpload not path /v1/analyses/files
    request_body @upload {
        max_size 21MB
    }
    request_body @notUpload {
        max_size 2MB
    }
    header {
        # 브라우저가 1년 동안 이 호스트를 HTTPS로만 부르게 한다. 평문 HTTP 응답에 붙어도 브라우저는 무시한다.
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }
    @internal path /actuator /actuator/*
    respond @internal 404
    # SSE는 버퍼 없이 바로 흘려보낸다. 나머지 경로는 기본 버퍼링을 그대로 쓴다.
    reverse_proxy @events app:8080 {
        flush_interval -1
    }
    reverse_proxy app:8080
}
