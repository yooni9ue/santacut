# /opt/santacut/backup.env (600, ubuntu). backup.sh가 source한다. 비밀값은 없다.
# rclone은 AWS_SHARED_CREDENTIALS_FILE의 앱 IAM 사용자 키로 S3에 쓴다.
# 버킷 정책이 SSE-KMS와 환경 키 ARN을 요구하므로 server_side_encryption, sse_kms_key_id가 꼭 있어야 한다.
# upload_cutoff=5G로 멀티파트 업로드를 피한다. 콜론이 든 값은 작은따옴표로 감싼다.
export AWS_SHARED_CREDENTIALS_FILE=/opt/santacut/aws/credentials
BACKUP_REMOTE=":s3,provider=AWS,env_auth=true,region=ap-northeast-2,no_check_bucket=true,server_side_encryption='aws:kms',sse_kms_key_id='arn:aws:kms:ap-northeast-2:<account>:key/<key-id>',upload_cutoff=5G:santacut-<env>-backup-<account>/backups/sqlite"
